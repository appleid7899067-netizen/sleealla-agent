# SlieQwenBoss Lo8 — backend hardening / production baseline
NODE_ENV=production
PORT=10000

# Existing model providers
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
MODEL_POOL=deepseek/deepseek-chat,google/gemini-2.5-flash,openai/gpt-oss-120b,qwen/qwen3-235b-a22b,meta-llama/llama-3.3-70b-instruct
LLM_MAX_TOTAL_ATTEMPTS=8

# Hardened backend auth — never commit real values
SESSION_SECRET=
AUTH_EMAIL=
# Format: scrypt$N$r$p$saltHex$derivedKeyHex
AUTH_PASSWORD_SCRYPT=
SESSION_TTL_MS=604800000

# Qwen server-side proxy — keeps the API key off the browser
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus

# CORS / MCP SSRF protection
APP_ORIGINS=https://your-frontend.example
MCP_ALLOWED_HOSTS=

# Production controls
RATE_LIMIT_PER_MIN=60
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=60000
AUDIT_LOG_STDOUT=true
