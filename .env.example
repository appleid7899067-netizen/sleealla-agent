# ==========================================
# 1. SERVER CONFIGURATION
# ==========================================
PORT=10000
APP_URL=http://localhost:10000
NODE_ENV=development

# ==========================================
# 2. LLM PROVIDER API KEYS
# ==========================================

# --- OpenRouter (แนะนำ: เข้าถึงได้หลายโมเดลในที่เดียว) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# รายการโมเดลที่จะลองสลับใช้หากตัวแรกล้มเหลว (คั่นด้วยเครื่องหมายจุลภาค)
MODEL_POOL=deepseek/deepseek-chat,google/gemini-2.5-flash,openai/gpt-oss-120b,qwen/qwen3-235b-a22b,meta-llama/llama-3.3-70b-instruct
# รายการโมเดลฟรีของ OpenRouter (ถ้ามี)
OPENROUTER_MODEL_FREE_LIST=deepseek/deepseek-r1-distill-llama-70b:free,google/gemini-2.0-flash-exp:free

# --- Alibaba DashScope (สำหรับ Qwen Models) ---
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-max
# Base URL สำหรับโหมดที่รองรับ OpenAI Compatible (ถ้ามี)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Groq (สำหรับความเร็วระดับ Ultra-low latency) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODELS=llama-3.3-70b-versatile,qwen-qwen3-235b-a22b,llama-3.1-8b-instant

# --- NVIDIA NIM ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Moonshot AI (Kimi) ---
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MOONSHOT_MODELS=moonshot-v1-8k,moonshot-v1-32k

# ==========================================
# 3. SYSTEM & BEHAVIOR SETTINGS
# ==========================================
# จำนวนครั้งสูงสุดที่จะลองสลับโมเดลเมื่อเกิดข้อผิดพลาด
LLM_MAX_TOTAL_ATTEMPTS=8

# เวลาหมดอายุของการเรียก API (มิลลิวินาที) ป้องกันเซิร์ฟเวอร์ค้าง
FETCH_TIMEOUT_MS=30000

# การตั้งค่าความปลอดภัยและ Integration
SLEELLA_SECURITY_AUTHORIZED=false
SLEELLA_MAX_RETRIES=8

# ==========================================
# 4. OPTIONAL / FUTURE EXPANSION
# ==========================================
# Puter Cloud Integration (ถ้ามีการใช้ Puter.js ในฝั่ง Frontend)
PUTER_AUTH_TOKEN=