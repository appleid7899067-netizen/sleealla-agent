PORT=10000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.5:free

# Optional provider keys for the model pool
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Sleella / Aether integration
SLEELLA_MAX_RETRIES=8
SLEELLA_SECURITY_AUTHORIZED=false
